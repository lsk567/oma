// The `web` backend, and the smallest periodic feedback loop the port manager
// panel can drive.
//
// `PortManager` is an ordinary team whose agent happens to be answered by a web
// client rather than a spawned process. Nothing is started for it: no command,
// no pane, no readiness. It exists as a name in the topology and an inbox in
// the invocation registry.
//
// What the panel may do is the wiring and nothing else:
//
//   - it sees `reading`, because that is what is connected to its input;
//   - it may set `setpoint`, because that is what its reaction declares.
//
// Neither is a setting of the panel. A client cannot reach a port the program
// did not give it, which is the whole reason the operator is a component here
// rather than a side channel into the run.
//
// The loop is closed, so nothing dangles: every input is fed by a connection or
// a timer, and there is no open input for anyone to write from outside.
//
// Deliberately not in the release gate: a web agent waits for an answer, and
// nothing in that harness would give one. A periodic timer also means the
// program never finishes on its own, the same reason `Heartbeat` sits it out.
// Compiled and backend-checked like every other source.
team Gauge[sensor : ClaudeCode]
{
    // A reaction sees only what triggers it, so the setpoint has to be a
    // trigger for the gauge to read it back.
    input setpoint : int
    output reading : string

    timer beat(0s, 30s)

    prompt sensor(beat, setpoint) -> reading
    "
        A monitoring tick fired at logical time $(beat). The setpoint currently
        in force is $(setpoint); `<absent>` means none has been chosen yet.

        Report the state of this machine's git working tree in one line: the
        current branch, and how many files are modified. Set `reading` to that
        line and nothing else.
    "
}

team PortManager[panel : Web]
{
    input reading : string
    output setpoint : int

    prompt panel(reading) -> setpoint within(10min)
    "
        The gauge reports: $(reading)

        Set `setpoint` to how many minutes should pass before you want to be
        asked again. It takes effect from the next tick, not this one.
    "
}

main WebPanel {
    gauge = Gauge()
    pm = PortManager()

    gauge.reading -> pm.reading after 0

    // A period's delay, so the answer lands with the next tick rather than at
    // the microstep after this one. Without it the setpoint would re-trigger
    // the gauge immediately, and the pair would spin at one timestamp forever
    // without the clock ever moving.
    pm.setpoint -> gauge.setpoint after 30s
}
