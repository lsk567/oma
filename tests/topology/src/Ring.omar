team Node(idx : int)[agent : Codex] {
  input   in : string
  output out : string
  prompt agent(in) -> out
  "
  Append \"node {idx}\" to the trail, then send the updated message to the output port out. To send the message onward, include exactly:

To: node K
  "
}

main {
  n1 = Node(1)
  n2 = Node(2)
  n3 = Node(3)
  
  // connections form a ring with three nodes
  n1.out -> n2.in
  n2.out -> n3.in
  n3.out -> n1.in
}